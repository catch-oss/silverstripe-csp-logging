{
	"name": "camspiers/silverstripe-csp-logging",
	"type": "silverstripe-vendormodule",
	"license": "MIT",
	"description": "Logs CSP violations through a logger",
	"authors": [
        {
            "name": "Cam Spiers",
            "email": "camspiers@gmail.com"
        },
        {
            "name": "Az Ilari",
            "email": "az@dev-io.us"
        }
    ],
	"autoload": {
		"psr-4": {
			"Camspiers\\CSP\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Camspiers\\CSP\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": "^8.5",
		"psr/log": "^3.0",
		"monolog/monolog": "^3.2",
		"silverstripe/vendor-plugin": "^3.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"silverstripe/framework": "^6.0"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	}
}
